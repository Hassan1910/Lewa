  "security_and_rls": {
    "requirements": [
      "Enable Row Level Security on all exposed application tables.",
      "Users can read public published content only.",
      "Users can read and update only their own profile.",
      "Users can read only their own bookings, payments and donations unless the role grants broader access.",
      "Staff/admin access must be role-controlled.",
      "Never place service-role credentials in the mobile application or browser.",
      "Use Edge Functions for privileged operations such as Paystack verification, webhook processing, role-sensitive operations and secret-bearing integrations.",
      "Validate all user input server-side.",
      "Rate-limit sensitive actions.",
      "Do not trust client-provided prices, payment statuses or role values.",
      "Store only the minimum personal information needed.",
      "Provide account deletion/data removal workflow where required by policy.",
      "Keep an audit trail for sensitive administrative operations."
    ]
  },
  "payments": {
    "flow": [
      "Client creates a pending booking or donation intent.",
      "Server calculates or verifies the amount from trusted database data.",
      "Edge Function initializes Paystack transaction.",
      "Client completes payment using the approved Paystack flow.",
      "Paystack sends webhook/event.",
      "Edge Function verifies transaction.",
      "Payment record is updated.",
      "Booking/donation is confirmed only after verified payment.",
      "User receives confirmation notification."
    ],
    "failure_states": [
      "Payment cancelled",
      "Payment failed",
      "Payment pending",
      "Payment verification failed",
      "Duplicate webhook",
      "Amount mismatch",
      "Booking no longer available"
    ]
  },
  "notifications": {
    "architecture": [
      "Store in-app notification record in Supabase.",
      "Register Expo push token for authenticated devices.",
      "Use a secure server-side function to send push notifications.",
      "Deep-link notification taps to the relevant mobile screen.",
      "Allow users to control categories of non-critical notifications."
    ],
    "examples": [
      "Your booking has been confirmed.",
      "A new conservation update has been published.",
      "An event you registered for is approaching.",
      "Your donation was received."
    ]
  },
  "state_and_data_strategy": {
    "rules": [
      "Use server state for remote Supabase data.",
      "Use local component state for temporary UI state.",
      "Cache read-heavy public content where useful.",
      "Invalidate relevant queries after mutations.",
      "Show skeletons rather than blank screens during loading.",
      "Use optimistic updates only where rollback is safe.",
      "Handle offline/poor-network states gracefully.",
      "Never treat cached booking/payment status as authoritative."
    ]
  },
  "error_and_empty_states": {
    "required": [
      "No internet connection",
      "Request timeout",
      "Server error",
      "Unauthorized",
      "Session expired",
      "No results",
      "No bookings",
      "No notifications",
      "No donation history",
      "Payment failed",
      "Booking unavailable",
      "Content unavailable",
      "Image failed to load"
    ],
    "ux_rule": "Every major screen must define loading, success, empty, error and retry states."
  },
  "accessibility": {
    "requirements": [
      "Readable text sizes",
      "Sufficient contrast",
      "Touch targets around 44x44 points or larger where practical",
      "Icons must have accessible labels",
      "Do not communicate meaning through color alone",
      "Support dynamic text sizing where feasible",
      "Use semantic labels for forms and controls",
      "Keep interactions simple and predictable"
    ]
  },
