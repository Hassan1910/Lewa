  "database_design": {
    "principles": [
      "Use UUID primary keys",
      "Use created_at and updated_at timestamps",
      "Use foreign keys",
      "Use enums or controlled status values where appropriate",
      "Use soft deletion/archive states for important content",
      "Use audit fields for administrative changes",
      "Do not store secrets in database rows accessible to clients"
    ],
    "tables": [
      {
        "name": "profiles",
        "purpose": "Application-level user profile linked to auth.users",
        "key_fields": [
          "id",
