{
  "document": {
    "title": "Lewa Wildlife Conservancy Mobile Application - Product Requirements Document",
    "version": "1.0",
    "status": "Implementation Ready",
    "basis": "Based on the supplied Kenya Methodist University research project proposal, with implementation details added for the selected modern technology stack.",
    "source_scope": "The proposal defines a Lewa Conservancy mobile application with an administrator web interface, database, visitor services, bookings, donations, wildlife information, conservation education, community engagement, events, tourism services, search, help, reports, feedback, payments, notifications, and About Us content.",
    "source_note": "The proposal explicitly names Android Studio and MySQL, but does not specify a mobile programming language, API architecture, authentication provider, push-notification provider, or payment gateway. This PRD replaces those implementation choices with the user's selected stack while preserving the proposed functional scope."
  },
  "technology_stack": {
    "mobile": {
      "framework": "React Native",
      "platform_tooling": "Expo",
      "language": "TypeScript",
      "navigation": "Expo Router",
      "forms_validation": "React Hook Form + Zod",
      "server_state": "TanStack Query where useful; Supabase client for direct data access",
      "local_storage": "AsyncStorage or Expo SecureStore depending on sensitivity",
      "notifications": "Expo Notifications",
      "maps_location": "Expo Location + a map provider if maps are required",
      "images": "Expo Image",
      "testing": "Jest + React Native Testing Library; Expo/EAS build testing"
    },
    "backend": {
      "platform": "Supabase",
      "services": [
        "PostgreSQL database",
        "Supabase Auth",
        "Row Level Security",
        "Storage",
        "Realtime where useful",
        "Edge Functions for trusted server-side operations"
      ]
    },
    "database": {
      "engine": "PostgreSQL",
      "design": "Relational, normalized, role-aware, auditable"
    },
    "authentication": {
      "provider": "Supabase Auth",
      "methods": [
        "Email/password",
        "Email verification",
        "Password reset",
        "Optional phone authentication if required later"
      ],
      "roles": [
        "visitor",
        "donor",
        "researcher",
        "community_member",
        "staff",
        "administrator",
        "super_admin"
      ]
    },
    "payments": {
      "provider": "Paystack",
      "scope": [
        "Bookings where payment is required",
        "Tourism services where payment is required",
        "Donations"
      ],
      "security": "Never trust payment status from the mobile client. Verify transactions server-side through a Supabase Edge Function and Paystack webhook."
    },
    "admin": {
      "framework": "React + Vite + TypeScript",
      "styling": "Tailwind CSS",
      "ui": "Accessible reusable component system",
      "charts": "A charting library such as Recharts",
      "data": "Supabase client with RLS and privileged operations through Edge Functions"
    },
    "deployment": {
      "mobile": "Expo EAS Build / EAS Submit",
      "admin": "Static hosting such as Vercel or Netlify",
      "backend": "Supabase",
      "environment_management": "Separate development, staging, and production environments where practical"
    }
  },
  "product_summary": {
    "name": "Lewa Wildlife Conservancy",
    "product_type": "Wildlife conservation, tourism, stakeholder engagement and visitor-service mobile platform",
    "primary_goal": "Give visitors, tourists, researchers, donors, community members and other stakeholders convenient access to Lewa information and services while giving staff a centralized administrative platform.",
    "primary_platform": "Mobile-first application with an administrator web dashboard",
    "core_value": [
      "Discover wildlife and conservation information",
      "Discover tourism services and activities",
      "Book visits, tours, accommodation and conservation activities",
      "Receive important conservation and wildlife updates",
      "Register for events",
      "Make donations",
      "Submit inquiries and feedback",
      "Access educational resources",
      "Allow administrators to manage content, bookings, users, donations and reports"
    ]
  },
