{
  "expo": {
    "name": "Lewa",
    "slug": "hafsa-lewa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hafsalewa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.chizicheza.hafsalewa",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#2F5D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2F5D3A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F5D3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b6d79db-cd86-4866-a764-9dd61ed83149"
      }
    },
    "owner": "chizicheza",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2b6d79db-cd86-4866-a764-9dd61ed83149"
    }
  }
}
